//@version=6
strategy("AI - Williams Alligator", overlay=true, calc_on_every_tick=false, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, slippage=3, pyramiding=1, margin_long=0, margin_short=0, fill_orders_on_standard_ohlc=true)

smma(src, length) =>
    smma = 0.0
    smma := na(smma[1]) ? ta.sma(src, length) : (smma[1] * (length - 1) + src) / length
    smma

jawLength = input.int(13, minval=1, title="Jaw Length")
teethLength = input.int(8, minval=1, title="Teeth Length")
lipsLength = input.int(5, minval=1, title="Lips Length")
jawOffset = input(8, title="Jaw Offset")
teethOffset = input(5, title="Teeth Offset")
lipsOffset = input(3, title="Lips Offset")
startDate = input(timestamp("01 Jan 2018 00:00"), "Start Date")
endDate = input(timestamp("31 Dec 2069 23:59"), "End Date")

jaw = smma(hl2, jawLength)
teeth = smma(hl2, teethLength)
lips = smma(hl2, lipsLength)

plot(jaw, "Jaw", offset=0, color=#2962FF)
plot(teeth, "Teeth", offset=0, color=#E91E63)
plot(lips, "Lips", offset=0, color=#66BB6A)

if lips > teeth and teeth > jaw and timestamp >= startDate and timestamp <= endDate
    strategy.entry("long", strategy.long)

if jaw > teeth and teeth > lips and timestamp >= startDate and timestamp <= endDate
    strategy.close_all()